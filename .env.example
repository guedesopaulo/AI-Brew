# Environment
ENVIRONMENT=local           # local | dev | prod

# Auth — local dev only
LOCAL_API_TOKEN=test-token  # must match VITE_API_TOKEN in frontend/.env.local

# LLM — Anthropic (cloud)
ANTHROPIC_API_KEY=

# LLM — Ollama (local, used when ENVIRONMENT=local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Storage
DB_PATH=brew.db
CHECKPOINT_DB_PATH=brew_checkpoints.db

# Agent MCP endpoint (must match the running FastAPI server)
MCP_BASE_URL=http://localhost:8000
